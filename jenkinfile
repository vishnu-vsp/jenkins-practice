pipeline
{
    agent any
    stages
    {
        stage('build')
        {
            steps
            {
              echo "Building the project..."
              sh 'npm install'
              sh 'pip install -r requirements.txt'
            }
        }
        stage('test')
        {
            steps
            {
              echo "Running tests..."
              sh 'npm test'
              sh 'pytest'
            }
        }
        stage('deploy')
        {
            steps
            {
              echo "Deploying the project..."
            }
        }
    }
}
